<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authorization</title>
    <link rel="stylesheet" href="../styles/authorization.css">
</head>

<body>

    <!-- ! Authorization form -->


    <form action="#" method="post" class="form">
        <img src="../pages/img/welcome.png" alt="" class="welcomeCat">
        <h1>Authorization</h1>
        <!-- ?Username -->
        <input type="text" class="form__username" id="username" name="username" placeholder="Login">
        <!-- ?Password -->
        <input type="password" class="form__password" id="password" name="password" placeholder="Password">
        <!-- ?Button to send a request to the database -->
        <button class="form__btn" href="/authorization">Log in</button>
        <p class="form__create">You don't have an account? <a href="/auth/registration">Create one!</a></p>
    </form>
</body>

</html>
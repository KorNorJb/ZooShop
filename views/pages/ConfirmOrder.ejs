<!DOCTYPE html>
<html lang="en">

<head>
    <!-- ! META TAGS    -->
    <!-- Todo Page Configuration -->
    <!-- ? Page encoding -->
    <meta charset="UTF-8">
    <!-- ? Adaptability -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <!-- ? Disabling link generation for a phone number on iOS -->
    <meta name="format-detection" content="telephone=no">

    <!-- Todo SEO -->
    <!-- ? Description of the page -->
    <meta name="description" content="">
    <!-- ? Page Keywords -->
    <meta name="keywords" content="">


    <!-- Todo Other Information -->
    <!-- ? Author of the page -->
    <meta name="Author" content="Igantovskiy Dmitriy Valerievich">
    <!-- ? Copyright -->
    <meta name="Copyright" content="Igantovskiy Dmitriy Valerievich">
    <!-- ? Author's address -->
    <meta name="Address" content="Tairova 27">



    <!-- !LINKS -->
    <!-- ? Other -->
    <link href="https://unpkg.com/boxicons@2.1.2/css/boxicons.min.css" rel="stylesheet" />

    <!-- todo Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />


    <!-- ? Styles -->
    <link rel="stylesheet" href="../styles/OrdersPage/style.css">

    <!-- ? Page icon -->
    <link rel="shortcut icon" href="../pages/img/HomePage/Header/Navbar/Logo.png">

    <!-- ? Page title -->
    <title>Confirm Your Order</title>
</head>

<body>
    <div class="header">
        <div class="header__container">
            <!-- TODO LOGO -->
            <a href="/" class="header__logo">
                <img src="../pages/img/HomePage/Header/Navbar/Logo.png" alt="">
            </a>

            <!-- todo Search bar -->
            <form action="">
                <div class="header__search">
                    <span class="search-icon material-symbols-outlined">search</span>
                    <input type="search" class="search__input" placeholder="Search...">
                </div>
            </form>
            <!-- TODO Header Buttons -->
            <div class="header__buttons">
                <% if (accessToken) { %>
                    <div id="profileIcon">
                        <a href="#"><img src="../pages/img/HomePage/Header/Navbar/user.png" alt="Profile Icon" class="profileImage" style="width: 50px; cursor: pointer;"></a>
                    </div>
                    <% } else { %>
                        <div class="header__buttons">
                            <a href="" class="button__signIn">Sign In</a>
                            <a href="" class="button__signUp"> Sign Up</a>
                        </div>
                        <% } %>
            </div>
        </div>
        <main>
            <h1>Order Confirmation</h1>
            <form action="/order-confirmation" method="POST">
                <div class="order__info">
                    <p>Order number: <span class="orderId" id="orderId"></span></p>
                    <p>Total amount: <span class="orderTotal" id="orderTotal"></span>₸</p>
                </div>
                <div class="order__inpt">
                    <input type="text" name="address" class="address">
                </div>
                <div id="orderItems"></div>
                <button href="" class="confirmBtn" type="submit">Confirm and pay</button>
            </form>
        </main>

        <!-- ! Footer -->
        <footer class="footer">
            <div class="footer__container">
                <div class="mainFooter__container">
                    <nav>
                        <h2>Navigation</h2>
                        <ul>
                            <li><a href="">Home</a></li>
                            <li><a href="">Catalog</a></li>
                            <li><a href="">About Us</a></li>
                            <li><a href="/privacy">Privacy policy</a></li>
                        </ul>
                    </nav>
                    <div class="footer__questions">
                        <form action="">
                            <h2>Still have questions?</h2>
                            <textarea name="" id="" cols="20" rows="4" placeholder="Enter your question here"></textarea>
                            <button>Send</button>
                        </form>
                    </div>
                </div>
                <div class="FooterOtherInfo__container">
                    <div class="footer__PaymentMethods">
                        <!-- Todo Pictures must be 64x64 in size -->
                        <img src="../pages/img/PaymentsMethode/Visa.png" alt="">
                        <img src="../pages/img/PaymentsMethode/MasterCard.png" alt="">
                    </div>
                    <div class="footer__Rights">
                        <p><a href="" style="cursor: pointer;">Privacy Policy</a> © 2024 Animals Kingdom. All Rights Reserved.</p>
                    </div>
                    <div class="footer__SocialMedia">
                        <img src="../pages/img/SocialMedia/inst.png" alt="">
                        <img src="../pages/img/SocialMedia/whatsapp.png" alt="">
                        <img src="../pages/img/SocialMedia/teleg.png" alt="">
                    </div>
                </div>
            </div>
        </footer>
        <script src="../scripts/ConfirmOrder.js"></script>
</body>

</html>
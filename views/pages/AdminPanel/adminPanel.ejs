<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
    <link rel="stylesheet" href="../../styles/AdminPanels/adminPanel.css">
</head>

<body>

    <header class="title-head">
        <h1 class="title">Admin panel</h1>
    </header>
    <main>

    </main>
    <main>
        <div class="main">
            <div class="accordion">
                <div class="accordion-content">
                    <header>
                        <span class="title">Add a new product</span>
                        <i class="fa-solid fa-plus"></i>
                    </header>
                    <form action="/api/admin" method="post" class="description">
                        <input type="text" name="name" class="form__name" required placeholder="Name Product`">
                        <input type="text" name="desc" class="form__desc" required placeholder="Description">
                        <input type="number" name="coast" class="form__coast" required placeholder="Coast">
                        <input type="number" name="articul" class="form__articul" required placeholder="Articul">
                        <input type="text" name="image" class="form__image" required placeholder="Path">
                        <input type="text" name="type" class="typeProduct" required placeholder="type">
                        <input type="text" name="brand" class="form__brand" required placeholder="bran">
                        <input type="number" name="weight" class="form__weight" required placeholder="weight">
                        <input type="number" name="netQua" class="form__netqua" required placeholder="netqua">
                        <input type="text" name="form" class="form__form" required placeholder="form">
                        <input type="number" name="age" class="age" required placeholder="age">
                        <input type="text" name="flavour" class="form__flavour" required placeholder="flavour">
                        <input type="number" name="available" class="form__available" required placeholder="available">
                        <button class="form__btn">Add</button>
                    </form>
                </div>
                <div class="list">
                    <% if(data){%>
                        <% data.forEach(products=>{%>
                            <div class="popular__card">
                                <div class="popular__image"><img src="../../pages/img/ForCards/<%= products.image_product%>" alt="DA"></div>
                                <div class="popular__info">
                                    <h2>
                                        <%= products.name_product%>
                                    </h2>
                                    <!-- <p class="desc">
                                        <%= products.desc_product%>
                                    </p> -->
                                    <p class="coast">
                                        <%= products.coast_product%> т
                                    </p>
                                </div>
                                <div class="popular__add">
                                    <button class="deletebtn <%= products._id%>">Delete</button>
                                </div>
                            </div>
                            <%})%>
                                <%}%>
                </div>
            </div>
